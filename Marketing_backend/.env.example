DJANGO_SECRET_KEY=your_secret_key_here
DEBUG=True

DATABASE_URL=postgres://user:password@localhost:5432/scaleezy
# Seconds to reuse healthy PostgreSQL connections (0 disables persistence).
DB_CONN_MAX_AGE=60

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

FERNET_SECRET_KEY=your_fernet_key_here

GEMINI_API_KEY=your_gemini_api_key

# Optional server fallback. A workspace's encrypted credential takes priority.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_REQUEST_TIMEOUT=60

META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=https://scaleezy-marketing-hub.vercel.app/social/meta/callback

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://scaleezy-marketing-hub.vercel.app/social/youtube/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://scaleezy-marketing-hub.vercel.app/social/linkedin/callback
LINKEDIN_API_VERSION=202408
LINKEDIN_SCOPES=openid profile email w_member_social

X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_OAUTH_REDIRECT_URI=https://your-app-domain.com/oauth/callback

TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

GOOGLE_BUSINESS_CLIENT_ID=your_google_business_client_id
GOOGLE_BUSINESS_CLIENT_SECRET=your_google_business_client_secret

# Comma-separated allowlist. Required in production; DEBUG allows all when empty.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Public signup: requests per client IP. Set NUM_PROXIES=0 when the app is not
# behind a reverse proxy.
SIGNUP_THROTTLE_RATE=5/hour
NUM_PROXIES=1

# Signup alerts. Each channel is optional — leave empty to disable it.
# Email: any SMTP provider (e.g. Gmail app password, SES, Resend SMTP).
SIGNUP_ALERT_EMAILS=ops@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# WhatsApp Cloud API: token + sending phone-number id from the Meta app, and
# comma-separated recipient numbers in E.164 (e.g. 9198xxxxxxxx). Recipients
# must have messaged the business number within 24h for free-form texts.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SIGNUP_ALERT_WHATSAPP_TO=

# Public frontend origin, used for the review link inside alerts.
PLATFORM_URL=https://your-app-domain.com
